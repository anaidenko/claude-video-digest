{
    "name": "@anaidenko/claude-video-digest",
    "description": "Lets Claude Code watch videos — screen recordings, share links, any video file — as a timestamped contact sheet and a transcript grouped under the frame each line was spoken over.",
    "//": "No version field on purpose: .claude-plugin/plugin.json is the single source of truth, and a second copy here would drift. publish.yml injects it at publish time; without it, a stray `npm publish` from a checkout fails.",
    "license": "MIT",
    "author": "Andrii Naidenko",
    "homepage": "https://github.com/anaidenko/claude-video-digest",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anaidenko/claude-video-digest.git"
    },
    "bugs": "https://github.com/anaidenko/claude-video-digest/issues",
    "keywords": [
        "claude-code",
        "claude-code-plugin",
        "claude-code-skill",
        "claude-skill",
        "claude",
        "video",
        "video-analysis",
        "video-transcript",
        "screen-recording",
        "transcript",
        "transcription",
        "whisper",
        "ffmpeg",
        "contact-sheet",
        "loom",
        "youtube",
        "macos",
        "linux"
    ],
    "bin": {
        "claude-video-digest": "bin/claude-video-digest.js"
    },
    "files": [
        ".claude-plugin/",
        "skills/",
        "scripts/",
        "!**/__pycache__/",
        "bin/",
        "CHANGELOG.md"
    ],
    "os": [
        "darwin",
        "linux"
    ],
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "doctor": "./scripts/video-digest.sh doctor",
        "lint": "command -v shellcheck >/dev/null || { echo 'shellcheck not installed: brew install shellcheck'; exit 1; }; shellcheck scripts/video-digest.sh test/install-suite.sh test/package-suite.sh",
        "lint:py": "python3 -m py_compile scripts/lib/*.py",
        "test": "./test/run-tests.sh",
        "test:install": "./test/install-suite.sh",
        "test:package": "./test/package-suite.sh",
        "test:docker": "./test/docker-test.sh",
        "docker:build": "docker build -t video-digest .",
        "docker:doctor": "docker run --rm video-digest doctor"
    }
}
